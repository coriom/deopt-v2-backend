# PUBLIC-TESTNET-DEPLOY-AND-SEED-V1 — public testnet production
# env template. Copy to `.env.production` (gitignored) and fill in
# the bracketed placeholders. NEVER commit a real `.env.production`.
#
# Posture: Base Sepolia (chain id 84532) ONLY. Mainnet is GATED in
# code; do not set CHAIN_ID=1 or CHAIN_ID=8453.

# === Server ========================================================
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# === Chain ========================================================
CHAIN_ID=84532
NETWORK_NAME=base-sepolia

# === Persistence (REQUIRED for public deploy) ====================
PERSISTENCE_ENABLED=true
# Postgres connection string. Use the secret store / PaaS injection
# of your host; never hard-code the password here.
DATABASE_URL=[postgres://<user>:<password>@<host>:5432/<db_name>]

# === Options =====================================================
OPTIONS_ENABLED=true
# CRITICAL: leave true ONLY for the initial seed window, then flip
# to false and restart. With true, ANY caller can POST /options/series
# (no auth). After seed, set false to refuse further series creation.
OPTIONS_ALLOW_MANUAL_SERIES=true
OPTIONS_REQUIRE_PERSISTENCE=true

# === Signature verification =====================================
# 'strict' enforces EIP-712 verification on every signed envelope.
# 'disabled' is the local-dev permissive mode — DO NOT use on a
# public deploy unless you've explicitly accepted the trust model.
SIGNATURE_VERIFICATION_MODE=strict

# === EIP-712 domain ============================================
# Must match what the frontend uses to sign. The frontend's signer
# domain is derived from chain id + the address(0) verifying-
# contract placeholder; if you change EIP712_VERIFYING_CONTRACT
# here, change it on the frontend too.
EIP712_NAME=DeOptV2
EIP712_VERSION=1
EIP712_CHAIN_ID=84532
EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000

# === CORS =======================================================
# Comma-separated list of allowed frontend origins. NEVER use "*"
# in production. Include only the URL the public frontend serves
# from (and any staging origins you want to support).
CORS_ALLOWED_ORIGINS=[https://your-frontend.example.com]

# === Executor / on-chain settlement ============================
# Leave disabled for the read/orderbook-only testnet beta.
# Enable only when on-chain settlement is in scope; require a real
# private key + RPC then.
EXECUTION_ENABLED=false
EXECUTOR_REAL_BROADCAST_ENABLED=false
EXECUTOR_DRY_RUN=true
SIMULATION_ENABLED=false
EXECUTOR_PRIVATE_KEY=
RPC_URL=

# === Mocks ======================================================
# `false` in production. The testnet mocks (mUSDC/mWETH/mWBTC) are
# already deployed on Base Sepolia; the backend doesn't need to be
# in "mocks-enabled" mode to talk to them.
TESTNET_MOCKS_ENABLED=false
