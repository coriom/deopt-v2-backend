HOST=127.0.0.1
PORT=8080
RUST_LOG=info

CHAIN_ID=84532
NETWORK_NAME=base-sepolia

# Order signature verification mode:
# - disabled: validates shape/nonce/deadline, skips cryptographic recovery
# - strict: enforces EIP-712 order signature verification
SIGNATURE_VERIFICATION_MODE=disabled

# Backend order EIP-712 domain
EIP712_NAME=DeOptV2
EIP712_VERSION=1
EIP712_CHAIN_ID=84532
EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000

# Persistence
PERSISTENCE_ENABLED=false
DATABASE_URL=postgres://deopt:deopt@127.0.0.1:5432/deopt_v2_backend

# Executor scaffold
EXECUTION_ENABLED=false
EXECUTOR_DRY_RUN=true
EXECUTOR_POLL_INTERVAL_MS=1000
EXECUTOR_MAX_BATCH_SIZE=10

# Real broadcast.
# Disabled by default. Do not commit private keys.
# Fee values are required when EXECUTOR_REAL_BROADCAST_ENABLED=true.
EXECUTOR_REAL_BROADCAST_ENABLED=false
EXECUTOR_PRIVATE_KEY=
EXECUTOR_CHAIN_ID=84532
EXECUTOR_MAX_GAS_LIMIT=1000000
EXECUTOR_MAX_FEE_PER_GAS_WEI=
EXECUTOR_MAX_PRIORITY_FEE_PER_GAS_WEI=
EXECUTOR_REQUIRE_SIMULATION_OK=true

# RPC simulation
SIMULATION_ENABLED=false
SIMULATION_REQUIRE_PERSISTENCE=true
RPC_URL=

# Executor address used as eth_call "from" during simulation.
EXECUTOR_FROM_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed contracts.
# Base Sepolia V2F state:
# - PERP_MATCHING_ENGINE = 0x774d96E5739bffadEE91508b4D3D74F5BE29F165
# - NEW (active) PerpEngine = 0xc6C592100723Fe0C66343A16e95eC34cC0c2141c
# - OLD (stranded under A3) PerpEngine = 0xB36395b67D0798ADA981731c9Fa5239F4362b53B
# Operators: never point PERP_ENGINE_ADDRESS at the OLD address.
# FeesManagerV2.isFeeConsumer(OLD) is false after V2F-LM, so any
# transaction routed at OLD will revert. OLD is observability-only.
PERP_MATCHING_ENGINE_ADDRESS=0x774d96E5739bffadEE91508b4D3D74F5BE29F165
PERP_ENGINE_ADDRESS=0xc6C592100723Fe0C66343A16e95eC34cC0c2141c

# V2F-P observability metadata.
# OLD_PERP_ENGINE_ADDRESS is used SOLELY by the
# `deopt_perp_fee_charged_v2_total{consumer="old"}` metric and the
# `PerpFeeChargedFromOldEngine` Prometheus alert to detect any
# FeeChargedV2 emitted by the stranded OLD PerpEngine. Never used to
# route broadcast or execution traffic. Leave unset to bucket every
# non-NEW PERP consumer as `unknown`.
OLD_PERP_ENGINE_ADDRESS=0xB36395b67D0798ADA981731c9Fa5239F4362b53B

# Base Sepolia V2G state — MarginEngine (OPTION).
# - NEW (active, V2-fees enabled per V2E-E) MarginEngine =
#   0x287Cef479be5889eEfCa847F9e73C860898f48Cc
# - OLD MarginEngine (legacy V2D-R; superseded — never use as active) =
#   0x6C5665De05e7314cB63cD77F82DFa86508A5b5F8
#
# `MARGIN_ENGINE` is the canonical active address; the option event
# indexer auto-falls-back to it when
# `OPTION_EVENT_INDEXER_MARGIN_ENGINE_ADDRESS` is unset.
MARGIN_ENGINE=0x287Cef479be5889eEfCa847F9e73C860898f48Cc

# V2G-F observability metadata.
# OLD_MARGIN_ENGINE_ADDRESS is used SOLELY by the
# `deopt_option_fee_charged_v2_total{consumer="old"}` metric and its
# rebated sibling. Never used to route broadcast / execution traffic.
# Leave unset (default) to bucket every non-NEW OPTION consumer as
# `unknown`. Set to the explicit legacy address if you want a dedicated
# `consumer="old"` arm for the OPTION alert.
OLD_MARGIN_ENGINE_ADDRESS=0x6C5665De05e7314cB63cD77F82DFa86508A5b5F8

# Base Sepolia V2G state — FeesManagerV2.
# Live address since V2E-E; merkle root + rebate budget seeded by
# V2G-C / V2G-D2; V2G-D3 claimed Tier 4 maker + Tier 2 taker; V2G-E
# broadcast the first live PERP + OPTION rebate trades through it.
FEES_MANAGER_V2=0x00dA0B9876bcBf0c79CB5BcAcfEBAFb8C7Ad774f

# Perp on-chain nonce sync
PERP_NONCE_SYNC_ENABLED=false
PERP_NONCE_SYNC_REQUIRE_RPC=true
PERP_NONCE_SYNC_STRICT=true

# Indexer
INDEXER_ENABLED=false
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_MAX_BLOCK_RANGE=500
INDEXER_REQUIRE_PERSISTENCE=true

# Reconciliation
RECONCILIATION_ENABLED=false
RECONCILIATION_REQUIRE_PERSISTENCE=true
RECONCILIATION_MAX_BATCH_SIZE=100

# Confirmation / finality
CONFIRMATION_ENABLED=false
CONFIRMATION_REQUIRE_PERSISTENCE=true
CONFIRMATION_REQUIRED_BLOCKS=2
CONFIRMATION_MAX_BATCH_SIZE=50
CONFIRMATION_REQUIRE_RECONCILIATION=true

# RFQ
RFQ_ENABLED=false
RFQ_REQUIRE_PERSISTENCE=true
RFQ_DEFAULT_TTL_MS=5000
RFQ_MAX_TTL_MS=30000
RFQ_MIN_QUOTE_TTL_MS=500
RFQ_MAX_QUOTE_TTL_MS=10000
RFQ_MAX_QUOTES_PER_RFQ=50
RFQ_QUOTE_SIGNATURE_MODE=disabled
RFQ_EIP712_NAME=DeOptV2RFQ
RFQ_EIP712_VERSION=1
RFQ_EIP712_CHAIN_ID=84532
RFQ_EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000

# Options V1D / Option RFQ V1C
OPTIONS_ENABLED=false
OPTIONS_REQUIRE_PERSISTENCE=true
OPTIONS_ALLOW_MANUAL_SERIES=true
OPTIONS_SYNC_ONCHAIN_REGISTRY=false
OPTIONS_DEFAULT_CONTRACT_SIZE_1E8=100000000
OPTION_RFQ_ENABLED=false
OPTION_RFQ_REQUIRE_PERSISTENCE=true
OPTION_RFQ_DEFAULT_TTL_MS=5000
OPTION_RFQ_MAX_TTL_MS=30000
OPTION_RFQ_MIN_QUOTE_TTL_MS=500
OPTION_RFQ_MAX_QUOTE_TTL_MS=10000
OPTION_RFQ_MAX_QUOTES_PER_RFQ=50
OPTION_RFQ_QUOTE_SIGNATURE_MODE=disabled
OPTION_RFQ_EIP712_NAME=DeOptV2OptionRFQ
OPTION_RFQ_EIP712_VERSION=1
OPTION_RFQ_EIP712_CHAIN_ID=84532
OPTION_RFQ_EIP712_VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000

# RFQ-MULTI-LEG-SCHEMA-V1 — multi-leg atomic RFQ master gate. Schema
# (migration 0043) is always ready; this flag guards any future
# service / route / MM Gateway wiring. Default OFF. Setting it true
# today has no observable effect because no route reads it yet;
# subsequent milestones (`RFQ-MULTI-LEG-CREATE-QUOTE-V1`,
# `_ATOMIC-ACCEPT-V1`, `_MM-GATEWAY-V1`) will gate their handlers on it.
OPTION_RFQ_MULTI_LEG_ENABLED=false
OPTION_EXECUTION_ENABLED=false
OPTION_EXECUTION_REQUIRE_PERSISTENCE=true
OPTION_MATCHING_ENGINE_ADDRESS=
OPTION_EXECUTION_SIGNATURE_MODE=disabled
OPTION_EXECUTION_CHAIN_ID=84532
OPTION_EXECUTION_EIP712_NAME=DeOptV2-OptionMatchingEngine
OPTION_EXECUTION_EIP712_VERSION=1
OPTION_EXECUTION_DEFAULT_SETTLEMENT_DECIMALS=6
OPTION_NONCE_SYNC_ENABLED=false
OPTION_NONCE_SYNC_REQUIRE_RPC=true
OPTION_NONCE_SYNC_STRICT=true
OPTION_EXECUTION_SIMULATION_ENABLED=false
OPTION_EXECUTION_REQUIRE_RPC_FOR_SIMULATION=true
OPTION_EXECUTION_SIMULATION_GAS_LIMIT=0
OPTION_EXECUTION_SIMULATION_FROM=
OPTION_EXECUTION_BROADCAST_ENABLED=false
OPTION_EXECUTION_REQUIRE_SIMULATION_OK=true
OPTION_EXECUTION_BROADCAST_GAS_LIMIT=0

# Fees & Rebates V1A
# Disabled by default. Ledger-only; no payouts or on-chain transfers.
FEES_ENABLED=false
FEES_REQUIRE_PERSISTENCE=true
FEES_REBATES_ENABLED=false
FEES_PROTOCOL_FEE_RECIPIENT=treasury
FEES_DEFAULT_FEE_ASSET=USDC
FEES_OPTION_FEE_BASIS=premium_or_underlying_capped
FEES_OPTION_PREMIUM_CAP_PCT=10

# Market Maker Gateway V1B
# Disabled by default. When enabled, starts a separate WebTransport UDP listener.
MM_GATEWAY_ENABLED=false
MM_GATEWAY_TRANSPORT=webtransport
MM_GATEWAY_HOST=127.0.0.1
MM_GATEWAY_PORT=8443
MM_GATEWAY_CERT_PATH=
MM_GATEWAY_KEY_PATH=
MM_GATEWAY_MAX_SESSIONS=100
MM_GATEWAY_MAX_IN_FLIGHT_PER_SESSION=128
MM_GATEWAY_RATE_LIMIT_PER_SEC=100
MM_GATEWAY_HEARTBEAT_TIMEOUT_MS=15000
MM_GATEWAY_MAX_ORDERS_PER_BULK=50
MM_GATEWAY_MAX_CANCELS_PER_BULK=100
MM_GATEWAY_MAX_OPEN_ORDERS_PER_ACCOUNT=500
MM_GATEWAY_CANCEL_ON_DISCONNECT=true
MM_GATEWAY_AUTH_MODE=disabled
MM_GATEWAY_REQUIRE_AUTH=false
MM_GATEWAY_CHALLENGE_TTL_MS=60000

# Market Maker permissions V1A
# Auth proves wallet identity; permissions decide allowed MM capabilities/products.
MM_PERMISSIONS_ENABLED=false
MM_PERMISSIONS_REQUIRE_PERSISTENCE=true

# Monitoring/Admin V1B
# Read-only operational observability endpoints under /admin plus safe /metrics and /ready.
# Admin is disabled by default; metrics is enabled for local scraping. Do not commit real tokens.
ADMIN_API_ENABLED=false
ADMIN_API_REQUIRE_TOKEN=false
ADMIN_API_TOKEN=
METRICS_ENABLED=true
METRICS_REQUIRE_ADMIN_TOKEN=false

# =====================================================================
# Perps — public trading gate, read layer, closed-test allowlist,
# workers, kill-switches, oracle/risk. Every dangerous toggle defaults
# false. Public Perps trading remains fail-closed until an operator
# explicitly opts in on a target that is NOT mainnet.
#
# Admin gate for the Perps admin ticks (POST /admin/perps/funding/tick,
# POST /admin/perps/liquidations/tick) is the SAME `ADMIN_API_*`
# machinery above. Use the `x-admin-token` HTTP header. NEVER commit a
# real token.
# =====================================================================

# --- Perps public trading gate (POST /perps/orders, DELETE /perps/orders/:id) ---
# Default false → the two new mutation routes return 503 `PerpsNotLive`
# at handler entry. Legacy `/orders`, `/rfqs*`, and
# `/execution-intents/*/signatures` stay permanently fail-closed
# regardless of this flag.
# `validate_startup` refuses `PERPS_PUBLIC_TRADING_ENABLED=true` on
# mainnet chain ids `1` or `8453`.
PERPS_PUBLIC_TRADING_ENABLED=false

# --- Perps closed-test gate + allowlist ---
# Independent of the public trading flag. When true, ONLY wallets
# whose lowercase address is on `PERPS_CLOSED_TEST_ALLOWLIST` can
# reach the Perps mutation surface; every other wallet returns 503.
# The allowlist is comma-separated lowercase hex EVM addresses; empty
# by default = no wallet allowed. Backend allowlist is authoritative;
# a frontend closed-test flag NEVER grants access.
# Refused on mainnet at startup, same as the public trading flag.
PERPS_CLOSED_TEST_ENABLED=false
PERPS_CLOSED_TEST_ALLOWLIST=

# --- Perps read layer (`GET /perps/markets*`, `.../positions`, etc) ---
# Off by default → read endpoints return 503 `PerpsReadDisabled`.
# When true, requires the market registry + oracle router addresses
# below; `validate_startup` refuses `PERPS_READ_ENABLED=true` on
# mainnet chain ids and refuses missing addresses.
PERPS_READ_ENABLED=false
# Optional override for the read layer's chain id; defaults to
# `CHAIN_ID`. Must match the deployed contracts.
PERPS_CHAIN_ID=84532

# --- Contract addresses (Base Sepolia, chain id 84532) ---
# Copy from the operator runbook or a fresh deployment log.
# Leave empty by default; the read layer refuses to start with
# `PERPS_READ_ENABLED=true` when either address is missing.
PERPS_MARKET_REGISTRY_ADDRESS=
PERPS_ORACLE_ROUTER_ADDRESS=

# --- Oracle freshness + deviation guard ---
# Staleness threshold for the on-chain oracle. A price older than
# this becomes `stale=true` on the wire, and the pre-submit gate
# rejects new-risk orders. Bounds: 1 ..= 3600.
PERPS_STALE_AFTER_SEC=60
# Max absolute deviation (basis points, 1e-4) between the trusted
# `index` and the mark used for execution. V1 has `mark == index`
# so this guard passes deterministically; a future divergence path
# rejects anything above threshold. Bounds: 1 ..= 5000.
PERPS_ORACLE_MAX_DEVIATION_BPS=500

# --- Per-market seed config (Base Sepolia) ---
# ETH-PERP. Onchain market id + asset addresses must match the
# deployed registry. Risk caps are enforced by the pre-submit gate:
# leaving them at the defaults matches the closed-test scope doc.
PERPS_ETH_SYMBOL=ETH-PERP
PERPS_ETH_ONCHAIN_MARKET_ID=1
PERPS_ETH_BASE_LABEL=ETH
PERPS_ETH_QUOTE_LABEL=mUSDC
PERPS_ETH_BASE_ADDRESS=
PERPS_ETH_QUOTE_ADDRESS=
PERPS_ETH_MAX_LEVERAGE=10
PERPS_ETH_MAINTENANCE_MARGIN_BPS=500
PERPS_ETH_MAX_ORDER_SIZE_1E8=1000000000
PERPS_ETH_MAX_ORDER_NOTIONAL_1E8=10000000000000
PERPS_ETH_MAX_SUBACCOUNT_NOTIONAL_1E8=50000000000000
PERPS_ETH_MAX_OPEN_INTEREST_1E8=5000000000

# BTC-PERP. Same shape; kept deferred in V1 with tight caps.
PERPS_BTC_SYMBOL=BTC-PERP
PERPS_BTC_ONCHAIN_MARKET_ID=2
PERPS_BTC_BASE_LABEL=BTC
PERPS_BTC_QUOTE_LABEL=mUSDC
PERPS_BTC_BASE_ADDRESS=
PERPS_BTC_QUOTE_ADDRESS=
PERPS_BTC_MAX_LEVERAGE=5
PERPS_BTC_MAINTENANCE_MARGIN_BPS=750
PERPS_BTC_MAX_ORDER_SIZE_1E8=100000000
PERPS_BTC_MAX_ORDER_NOTIONAL_1E8=10000000000000
PERPS_BTC_MAX_SUBACCOUNT_NOTIONAL_1E8=50000000000000
PERPS_BTC_MAX_OPEN_INTEREST_1E8=500000000

# --- Periodic funding worker (`spawn_perps_funding_worker`) ---
# `WORKER_ENABLED=false` → the periodic loop never spawns.
# `TICK_ENABLED=false` → the KILL-SWITCH; both the periodic worker
# AND the admin HTTP tick `POST /admin/perps/funding/tick` respect it
# and return a zero-count response envelope when disabled. Flip
# `TICK_ENABLED=false` to safely disable ticks without restarting the
# worker loop. `INTERVAL_SEC` bounds: 30 ..= 86400.
PERPS_FUNDING_WORKER_ENABLED=false
PERPS_FUNDING_TICK_ENABLED=false
PERPS_FUNDING_WORKER_INTERVAL_SEC=3600
PERPS_FUNDING_MAX_MARKETS_PER_TICK=32
# V1 only supports `skip` (skip the stale/unavailable market for this tick).
PERPS_FUNDING_STALE_ORACLE_POLICY=skip

# --- Periodic liquidation worker (`spawn_perps_liquidation_worker`) ---
# Same two-layer gate as the funding worker. `INTERVAL_SEC` bounds:
# 5 ..= 3600.
PERPS_LIQUIDATION_WORKER_ENABLED=false
PERPS_LIQUIDATION_TICK_ENABLED=false
PERPS_LIQUIDATION_WORKER_INTERVAL_SEC=30
PERPS_LIQUIDATION_MAX_POSITIONS_PER_TICK=500
PERPS_LIQUIDATION_STALE_ORACLE_POLICY=skip
