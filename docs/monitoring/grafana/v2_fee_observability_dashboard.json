      "id": 9,
      "title": "Unknown consumer events (PERP + OPTION)",
      "description": "Total V2 fee/rebate events whose consumer matches neither the configured NEW nor the optional OLD engine. Drives PerpFeeConsumerUnknown / OptionFeeConsumerUnknown alerts. Common causes: env-var drift on PERP_ENGINE_ADDRESS / MARGIN_ENGINE / OLD_*_ADDRESS, or a third engine registered as a FeesManagerV2 consumer.",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "deopt_perp_fee_charged_v2_total{consumer=\"unknown\"} + deopt_perp_fee_rebated_v2_total{consumer=\"unknown\"} + deopt_option_fee_charged_v2_total{consumer=\"unknown\"} + deopt_option_fee_rebated_v2_total{consumer=\"unknown\"}",
