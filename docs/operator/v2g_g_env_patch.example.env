# V2G-G — operator-only patch for the local (gitignored) `.env`.
#
# NEVER commit this — copy the lines below into your gitignored
# `deopt-v2-backend/.env` (or apply via shell-only `export` for a single
# session). The agent that produced this file does NOT edit the real
# `.env` per the V2G hard-rules; this template is documentation.
#
# After applying:
#   1. Restart the backend.
#   2. Verify the four V2 consumer-bucket gauges classify into `new`
#      (V2G-G verification commands at the bottom of this file).
#
# Source-of-truth addresses (Base Sepolia, V2G band):
#   FEES_MANAGER_V2     = 0x00dA0B9876bcBf0c79CB5BcAcfEBAFb8C7Ad774f
#   NEW PerpEngine      = 0xc6C592100723Fe0C66343A16e95eC34cC0c2141c   (active, V2-fees ON since V2F-L)
#   OLD PerpEngine      = 0xB36395b67D0798ADA981731c9Fa5239F4362b53B   (stranded under A3, observability-only)
#   NEW MarginEngine    = 0x287Cef479be5889eEfCa847F9e73C860898f48Cc   (active, V2-fees ON since V2E-E)
#   OLD MarginEngine    = 0x6C5665De05e7314cB63cD77F82DFa86508A5b5F8   (legacy, observability-only)
#   mUSDC (settlement)  = 0x6eAe407f5640B006faC9965182e238582A3B412E   (6dp; rebate budget gauge keyed here)
#
# Hard rules respected by this patch:
#   * `PERP_ENGINE_ADDRESS` MUST be the NEW address (never OLD).
#   * `OLD_*_ADDRESS` are observability-only — backend never routes
#     broadcast / execution at them; they only feed the metric
#     classifier and the V2G-F alert rules.
#   * No private keys, no broadcast surfaces, no DB destructive flags.

# --- begin operator patch (paste into local `.env`) ---

# Active PERP engine (V2F band, NEW). Operators: never set this to the
# OLD address — `FeesManagerV2.isFeeConsumer(OLD) == false`, so every
# broadcast through OLD will revert.
PERP_ENGINE_ADDRESS=0xc6C592100723Fe0C66343A16e95eC34cC0c2141c

# Observability-only OLD PERP address. Drives the V2F-Q
# `deopt_perp_fee_charged_v2_total{consumer="old"}` /
# `deopt_perp_fee_rebated_v2_total{consumer="old"}` gauges and the
# `PerpFeeChargedFromOldEngine` / `PerpFeeRebatedFromOldEngine` alerts.
OLD_PERP_ENGINE_ADDRESS=0xB36395b67D0798ADA981731c9Fa5239F4362b53B

# Active MarginEngine (V2E band, NEW). Used by the OPTION event indexer
# and the V2G-F OPTION consumer classifier.
MARGIN_ENGINE=0x287Cef479be5889eEfCa847F9e73C860898f48Cc

# Observability-only OLD MarginEngine. Drives the V2G-F OPTION OLD-bucket
# alerts (`OptionFeeChargedFromOldMarginEngine` /
# `OptionFeeRebatedFromOldMarginEngine`). Leave unset to bucket
# every non-NEW OPTION consumer as `unknown`.
OLD_MARGIN_ENGINE_ADDRESS=0x6C5665De05e7314cB63cD77F82DFa86508A5b5F8

# FeesManagerV2 — live since V2E-E. Subscribed by the option event
# indexer for the V2 FeeChargedV2 / FeeRebatedV2 / RebateBudget*
# event families.
FEES_MANAGER_V2=0x00dA0B9876bcBf0c79CB5BcAcfEBAFb8C7Ad774f

# --- end operator patch ---


# ============================================================================
# V2G-G verification commands (run AFTER patching + restarting the backend).
# ============================================================================
#
# 1. Confirm the running env without printing secrets (process env only).
#    Lists exactly the V2-fee classifier env vars + non-secret toggles:
#
#      bash -c '
#        for v in PERP_ENGINE_ADDRESS OLD_PERP_ENGINE_ADDRESS \
#                 MARGIN_ENGINE OLD_MARGIN_ENGINE_ADDRESS \
#                 FEES_MANAGER_V2 METRICS_ENABLED ADMIN_API_ENABLED; do
#          val=$(env | awk -F= -v k="$v" "\$1==k {print substr(\$0, length(k)+2)}")
#          printf "%-30s = %s\n" "$v" "$val"
#        done
#      '
#
#    Expect each address line to match the values pinned above. The
#    rest is sanity (METRICS_ENABLED=true, ADMIN_API_ENABLED=true).
#    Do not paste the output if you also have any *_PRIVATE_KEY in
#    your env — those would not be captured by this filter but it is
#    still safer to redirect to a file first and review.
#
# 2. Hit the backend admin config + V2 fee observability endpoints
#    (replace `$ADMIN_TOKEN` with the value of `ADMIN_API_TOKEN`):
#
#      curl -sH "x-admin-token: $ADMIN_TOKEN" \
#        http://127.0.0.1:8080/admin/config | jq '.contracts'
#
#      curl -sH "x-admin-token: $ADMIN_TOKEN" \
#        http://127.0.0.1:8080/admin/fees/v2/observability | jq '
#          .contracts,
#          .anomaly_totals,
#          .metrics.perp_fee_charged_v2_by_consumer,
#          .metrics.option_fee_charged_v2_by_consumer,
#          .metrics.fees_manager_v2_rebate_budget_native'
#
#    Expected on Base Sepolia today (V2G-E live state):
#      contracts.perp_engine_new   == "0xc6C592...141c"
#      contracts.perp_engine_old   == "0xB363...b53B"
#      contracts.margin_engine_new == "0x287Cef...48Cc"
#      contracts.margin_engine_old == "0x6C5665...b5F8"
#      contracts.fees_manager_v2   == "0x00dA0B...774f"
#      anomaly_totals.old_consumer_events == 0
#      anomaly_totals.unknown_consumer_events == 0
#      perp_fee_charged_v2_by_consumer  = {new: 3, old: 0, unknown: 0}
#      option_fee_charged_v2_by_consumer = {new: 3, old: 0, unknown: 0}
#      fees_manager_v2_rebate_budget_native["0x6eae407f...412e"] == 999987
#
# 3. Sanity-check the raw `/metrics` scrape that Prometheus will pull:
#
#      curl -sH "x-admin-token: $ADMIN_TOKEN" \
#        http://127.0.0.1:8080/metrics |
#        grep -E '^deopt_(perp|option)_fee_(charged|rebated)_v2_total|^deopt_fees_manager_v2_rebate_budget_native'
#
#    The `consumer="old"` / `consumer="unknown"` arms of every gauge
#    must read `0`; the rebate budget gauge must match the on-chain
#    `FeesManagerV2.rebateBudget(mUSDC)` value.
#
# 4. (Optional, additionally read-only.) Compare against the on-chain
#    ground truth via cast — no signer key required for `cast call`:
#
#      cast call $FEES_MANAGER_V2 'rebateBudget(address)(uint256)' \
#        0x6eAe407f5640B006faC9965182e238582A3B412E --rpc-url $RPC_URL
#
#    Result should match the gauge value (`999987` today).
#
# ============================================================================
# Hard refusals — the operator MUST NOT:
# ============================================================================
#  * set PERP_ENGINE_ADDRESS to the OLD address;
#  * point MARGIN_ENGINE at the legacy address;
#  * change Merkle root, rebate budget, or fee consumer wiring via this
#    file (those are governance/timelock writes, handled separately);
#  * commit this file's resolved values into `.env` (which is
#    gitignored), `.env.example`, or any other committed template
#    other than the documented `.env.example` already in the repo.
