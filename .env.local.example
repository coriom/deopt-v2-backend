# DeOpt v2 backend — LOCAL DEV ENVIRONMENT TEMPLATE
#
# Posture: localhost dev only. Base Sepolia READ-ONLY view if RPC is
# pointed at it. **NEVER mainnet.** Copy to `.env.local` (gitignored) for
# local use; do NOT commit real values. The CLI script
# `scripts/local-backend.sh` reads this template and applies safe
# overrides so a stray broadcast flag in your `.env.local` cannot fire
# a chain transaction.
#
# This is NOT the production `.env`. Do not overwrite the production
# `.env` with this file.

# --- HTTP server ---
HOST=127.0.0.1
PORT=8080
RUST_LOG=info

# --- Chain identity ---
CHAIN_ID=84532
NETWORK_NAME=base-sepolia

# --- CORS (lets the local Next.js dev server at :3000 / :3001 call this backend) ---
# Next.js auto-bumps to 3001 when 3000 is in use; include both so local
# QA works either way without re-editing this file.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Persistence (set TRUE if you have local Postgres running) ---
PERSISTENCE_ENABLED=false
# DATABASE_URL=postgres://deopt:deopt@127.0.0.1:5432/deopt_v2_backend

# --- Safety locks (NEVER set these to true for local product testing) ---
EXECUTION_ENABLED=false
EXECUTOR_DRY_RUN=true
EXECUTOR_REAL_BROADCAST_ENABLED=false
OPTION_EXECUTION_BROADCAST_ENABLED=false
OPTION_EXECUTION_SIMULATION_ENABLED=false
OPTION_NONCE_SYNC_ENABLED=false
PERP_NONCE_SYNC_ENABLED=false
INDEXER_ENABLED=false
RECONCILIATION_ENABLED=false
CONFIRMATION_ENABLED=false
ADMIN_API_ENABLED=false
METRICS_ENABLED=true

# --- Options + RFQ in-memory mode (lets /options/products respond cleanly) ---
OPTIONS_ENABLED=true
OPTIONS_REQUIRE_PERSISTENCE=false
OPTION_RFQ_ENABLED=true
OPTION_RFQ_REQUIRE_PERSISTENCE=false
OPTION_EXECUTION_ENABLED=false
OPTION_EXECUTION_REQUIRE_PERSISTENCE=false

# --- Public contract addresses (Base Sepolia, current canonical) ---
# These let the trading-views surface return contract metadata; without
# them, /accounts/.../portfolio honestly returns CONFIG_MISSING warnings.
OPTION_MATCHING_ENGINE_ADDRESS=0x5a5EBF9A9CCd7c012518569DE8283982982670f6
OPTION_MARGIN_ENGINE_ADDRESS=0x506cD65a63C53c66ab572B9f9dd819B7BfE00D30
OPTION_PRODUCT_REGISTRY_ADDRESS=0x3d52b033fab00ed6104dd3bc0a715f8648344eca
OPTION_COLLATERAL_VAULT_ADDRESS=0x00340C360353a5AB784c5Bc5c44322A6AF0625D3
OPTION_COLLATERAL_VAULT_VIEWS_ADDRESS=0x00340C360353a5AB784c5Bc5c44322A6AF0625D3
OPTION_ORACLE_ROUTER_ADDRESS=0xb416406f200b2ef3d7a86a5d5877ed41d9b1a581
OPTION_MARGIN_ENGINE_LENS_ADDRESS=0x496A57CF4e0d4F1BC5c00969Ed4C5204072ddA26
COLLATERAL_TOKEN=0x6eAe407f5640B006faC9965182e238582A3B412E

# --- Optional public read RPC for honest mark prices ---
# If you set this, the backend can do eth_call reads against Base Sepolia
# (read-only; no transactions are signed). Use a PUBLIC endpoint only —
# never paste a private RPC URL with an API key into a `.example` file
# that might end up in git history.
# RPC_URL=https://sepolia.base.org

# --- Executor signing (LEAVE EMPTY for local product testing) ---
EXECUTOR_PRIVATE_KEY=

# --- Admin auth (no token needed in local mode; admin is disabled) ---
ADMIN_API_REQUIRE_TOKEN=false
ADMIN_API_TOKEN=
