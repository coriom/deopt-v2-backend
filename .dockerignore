# Keep the build context small + avoid leaking local-only files.
target/
__pycache__/
*.pyc
**/target/
node_modules/
**/node_modules/

# No environment files enter the build context, including examples.
.env*

# Build artefacts + editor noise
.vscode/
.idea/
*.log
.DS_Store

# Git internals (not needed in the image)
.git/
.github/

# Tests + fixtures aren't needed at runtime; sqlx::migrate!()
# embeds migrations at compile time so the `migrations/` dir is
# read only at runtime via the COPY above.
tests/
docs/
